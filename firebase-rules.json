{
  "rules": {
    ".read": false,
    ".write": false,
    "appData": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },
    "calendar": {
      "$month": {
        ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'mantenimiento')",
        ".write": "auth != null && auth.token.role === 'admin'"
      }
    }
  }
}
